# Component specifically for defining the command line switches constants
# This allows other code to depend *only* on the switch names without
# needing the full manager implementation logic.
component("manager_switches") {
  sources = [
    "manager_switches.cc",
    "manager_switches.h",
  ]

  # This define is crucial for the COMPONENT_EXPORT mechanism
  # It signals that this build target is the "implementation" side.
  defines = [ "IS_MANAGER_IMPL" ]

  deps = [ "//base" ] # Depends on base for COMPONENT_EXPORT macros

  # Public exposure (other targets can depend on this)
  # Allows depending code to include manager_switches.h
  public = [ "manager_switches.h" ]
}


